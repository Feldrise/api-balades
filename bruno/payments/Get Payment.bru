meta {
  name: Get Payment
  type: http
  seq: 1
}

get {
  url: {{base_url}}/payments/{{payment_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

docs {
  Restricted to the booker of the payment's reservation, an admin or guide allowed to view the ramble's registrations, or staff with view:payments or manage:payments.
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
