meta {
  name: Refund Payment
  type: http
  seq: 2
}

post {
  url: {{base_url}}/payments/{{payment_id}}/refund
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "amount": 1000,
    "reason": "requested_by_customer"
  }
}

docs {
  Refunds a payment, entirely without amount or partly with an amount in cents up to what is left to refund. Refunds add up in refund_amount: the payment is partially_refunded, then refunded once entirely; the reservation counts its net amount as paid. Restricted to refund:payments or manage:payments.

  Refused, with nothing refunded: 400 `invalid_refund_amount` for an amount below 1 cent; 409 `refund_exceeds_refundable` for more than is left to refund (as recorded, or as Stripe knows it); 409 `payment_not_refundable` for a payment not succeeded; 422 `refund_refused` when Stripe refuses it for another reason. A 500 leaves unknown whether Stripe made the refund: retrying the same amount does not refund it twice.
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
