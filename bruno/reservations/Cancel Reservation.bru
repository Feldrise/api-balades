meta {
  name: Cancel Reservation
  type: http
  seq: 7
}

put {
  url: {{base_url}}/reservations/{{reservation_id}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

docs {
  Cancels the whole reservation and admits the waiting reservations that fit. has_successful_payment tells to contact the guide for a refund.
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
